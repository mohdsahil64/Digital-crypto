# Copy this file to .env and fill in the values. NEVER commit .env.

# Private key of the wallet that will DEPLOY the contract (needs BNB for gas).
# This same wallet becomes the initial admin/owner.
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_or_with_0x

# The admin wallet that RECEIVES the $5 USDT joining fees.
# Can be the same as deployer, or a separate wallet.
ADMIN_WALLET=0xYourAdminWalletAddress

# BSC mainnet USDT (BEP-20) token address. Default is the official Binance-Peg USDT.
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Plan price in USDT (18 decimals on BSC USDT). 5 USDT = 5.
PLAN_PRICE_USDT=5

# Optional: BscScan API key for contract verification.
BSCSCAN_API_KEY=your_bscscan_api_key
