# ─────────────────────────────────────────────────────────
# Copy to .env and fill in real values.
# All VITE_ vars are baked into the frontend build — do NOT
# put any secrets here. Only public addresses go here.
# ─────────────────────────────────────────────────────────

# Deployed contract address on BSC mainnet
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# BEP-20 USDT token address on BSC (Binance-Peg USDT)
VITE_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Admin wallet that receives the $5 plan payment
VITE_ADMIN_WALLET=0xYourAdminWalletAddress

# Backend API base URL — your VPS domain (no trailing slash)
# Same domain as frontend because Nginx proxies /api/ to Express
VITE_API_URL=https://yourdomain.com

# WalletConnect Cloud project id (free from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Joining fee shown in the UI (must match PLAN_PRICE_USD in backend)
VITE_JOINING_FEE=5
