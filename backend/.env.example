# ─────────────────────────────────────────────────────────
# Copy to .env and fill in real values.
# NEVER commit .env to git — it contains private keys.
# ─────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=production

# PostgreSQL — on VPS usually:
#   postgresql://dw_user:STRONG_PASSWORD@localhost:5432/decentralized_world
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decentralized_world

# BSC RPC (use a private node or Ankr/QuickNode for reliability in production)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Deployed smart contract address on BSC mainnet
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Admin wallet address (receives $5 plan payments)
ADMIN_WALLET=0xYourAdminWalletAddress

# Admin wallet PRIVATE KEY — used to send withdrawals from admin wallet to users.
# Keep this extremely secret. Never share or commit.
ADMIN_PRIVATE_KEY=0xYourAdminWalletPrivateKey

# BEP-20 USDT token address on BSC (default is Binance-Peg USDT)
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Plan price in USD (default $5)
PLAN_PRICE_USD=5

# Minimum withdrawal amount in USD
MIN_WITHDRAWAL_USD=5

# 1 internal dollar = how many USDT on withdrawal (default 1:1)
USDT_PER_USD=1

# CORS: your frontend domain (no trailing slash)
# Multiple origins comma-separated: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_ORIGIN=https://yourdomain.com

# Secret key for admin JWT tokens — use a long random string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_a_long_random_secret
